generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// DaySpanのDBには、Google Calendarの予定本体とNotionタスク本体を恒久的に保存しない
// （docs/spec.md §19）。ここに置くのは連携設定・表示設定・連携メタデータのみ。

// --- 認証 ---
// セッション管理はSupabase Auth側が行うため、Account/Session/VerificationTokenは持たない。
// SupabaseのユーザーID（auth.users.id）を外部キーとして紐付ける。

model User {
  id             String  @id @default(cuid())
  supabaseUserId String  @unique
  email          String? @unique
  name           String?
  image          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  googleAccounts       GoogleAccount[]
  googleConnectIntents GoogleConnectIntent[]
  calendarSettings     CalendarSetting[]
  notionConnection     NotionConnection?
  uiSetting            UiSetting?
  activityPresets      ActivityPreset[]
  runningActivity      RunningActivity?
  widgetToken          WidgetToken?
  sleepHealthSent      SleepHealthSent[]
  sleepHealthExport    SleepHealthExport?
  travelPlans          TravelPlan[]
  taskEventLinks       TaskEventLink[]
  eventOutcomes        EventOutcome[]
  annualLeaveGrants    AnnualLeaveGrant[]
  internalTaskOperations InternalTaskOperation[]

  pushSubscriptions         PushSubscription[]
  apnsDevices               ApnsDevice[]
  liveActivityDevices       LiveActivityDevice[]
  liveActivityTokens        LiveActivityToken[]
  activityStopToken         ActivityStopToken?
  notificationSetting       NotificationSetting?
  notificationJobs          NotificationJob[]
  eventNotificationSettings EventNotificationSetting[]
}

// サーバー間タスク操作の再送を識別する記録。タスク本体はNotionに置いたまま、
// 同じ要求で作成・完了を二重に実行しないための最小限のメタデータだけを持つ。
model InternalTaskOperation {
  id             String   @id @default(cuid())
  userId         String
  idempotencyKey String
  operation      String
  taskId         String?
  requestHash    String   @db.VarChar(64)
  state          String   @default("PROCESSING")
  result         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, taskId, operation])
}

// --- Google Calendar連携 ---
// ログイン用のGoogle OAuth（Supabase Auth）とは別に、DaySpan専用のOAuthクライアントで
// カレンダー権限のみを追加取得する（docs/spec.md §17）。共有Supabase/GCPプロジェクトの
// 同意画面にセンシティブスコープを足さずに済ませるための分離。
model GoogleAccount {
  id           String @id @default(cuid())
  userId       String
  googleUserId String // Google IDトークンの sub
  email        String

  // アクセストークン・リフレッシュトークンは secret-cipher.ts でAES-256-GCM暗号化して保存する
  accessToken          String?   @db.Text
  accessTokenExpiresAt DateTime?
  refreshToken         String    @db.Text
  scope                String    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarSettings CalendarSetting[]

  @@unique([userId, googleUserId])
  @@index([userId])
}

// 表示対象カレンダーのON/OFFと表示順（docs/spec.md §7）。
// カレンダー名・色はGoogle側が一次情報源のため保存せず、表示時に取得する。
model CalendarSetting {
  id              String @id @default(cuid())
  userId          String
  googleAccountId String
  calendarId      String // Google Calendar API上のカレンダーID

  visible         Boolean @default(true) // カレンダー画面に予定を出すか
  // 書き込んでよいか。表示とは別に持つ。見たいだけのカレンダー（共有された予定表など）へ
  // 書き込ませないため、また画面に出さないカレンダーを保存先には使えるようにするため。
  // 判定は services/calendar/write-context.ts で行い、UIではなくサービス層で塞ぐ。
  writeEnabled    Boolean @default(true)
  sortOrder       Int     @default(0)
  isCreateDefault Boolean @default(false) // 予定新規作成時の既定の保存先

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleAccount GoogleAccount @relation(fields: [googleAccountId], references: [id], onDelete: Cascade)

  @@unique([googleAccountId, calendarId])
  @@index([userId])
}

// --- Notion連携 ---
// MVPではユーザーがNotionのInternal Integration Tokenを入力する方式（docs/spec.md §18）。
// 将来のNotion OAuthへ差し替えられるよう、トークンの取得元は accessToken に集約する。
model NotionConnection {
  id     String @id @default(cuid())
  userId String @unique

  accessToken   String  @db.Text // 暗号化して保存
  workspaceName String?

  // Notion API 2025-09-03以降、プロパティとクエリの対象はデータベースではなくデータソース。
  // 実際の読み書きには taskDataSourceId を使い、taskDatabaseId は画面表示・リンク用に持つ。
  taskDataSourceId String?
  taskDatabaseId   String?
  taskTitle        String?

  // アプリ側の項目名 → Notionプロパティ名の対応。プロパティ名はユーザーが自由に付けられるため
  // 固定名を前提にせず、接続時の検証結果をここへ保存する（docs/spec.md §9）。
  propertyMap Json?

  // 記念日・更新日など、完了を持たない日付リマインド用のデータソース。
  reminderDataSourceId String?
  reminderDatabaseId   String?
  reminderTitle        String?
  reminderPropertyMap  Json?

  // よく行く場所。予定の「場所」欄の入力候補として読むだけで、DaySpan側には保存しない。
  placeDataSourceId String?
  placeDatabaseId   String?
  placeTitle        String?
  placePropertyMap  Json?

  // ゴミの収集日。myroomが日次で書き直すDBで、DaySpanからは読むだけ（docs/spec.md §9）。
  garbageDataSourceId String?
  garbageDatabaseId   String?
  garbageTitle        String?
  garbagePropertyMap  Json?

  // 勤務場所と出張（docs/spec.md §34）。1日1件の勤務場所と、期間で1件の出張を同じDBに置く。
  // Googleの予定にもタスクにも入る欄が無い記録だが、DaySpanのDBではなくNotionを一次情報源に
  // するのは、後から見返して集計し、手で直す種類の記録のため（場所DBと同じ考え方）。
  workDataSourceId String?
  workDatabaseId   String?
  workTitle        String?
  workPropertyMap  Json?

  // 買い物リスト（docs/spec.md §36）。shopping-listアプリが読み書きしているDBをそのまま指せる。
  // タスク・日付リマインド・場所・勤務と同じく、一次情報源はNotion側でDaySpanには保存しない。
  shoppingDataSourceId String?
  shoppingDatabaseId   String?
  shoppingTitle        String?
  shoppingPropertyMap  Json?

  // 出張扱いにする勤務場所の名前（string[]）。その場所を選んだ時点で「出張」の既定が立つ。
  // UiSettingではなくここに置くのは、勤務場所の選択肢が勤務記録DBのselectのプロパティ定義
  // そのもので、DBを選び直せば選択肢ごと入れ替わるため。UiSettingへ置くと、DBを差し替えた
  // あとも古い場所名が残り、どの画面からも消せなくなる。
  workTripPlaces Json?

  lastValidatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- UI表示設定 ---

enum CalendarViewType {
  MONTH
  DAY_1
  DAY_3
  DAY_7
}

model UiSetting {
  id     String @id @default(cuid())
  userId String @unique

  defaultMobileView  CalendarViewType @default(MONTH)
  defaultDesktopView CalendarViewType @default(DAY_7)
  weekStartsOn       Int              @default(0) // 0=日曜
  timeZone           String           @default("Asia/Tokyo")
  autoRefreshSeconds Int              @default(300) // 一定間隔での自動更新（docs/spec.md §20）

  // 活動記録の初期項目（docs/spec.md §27）を入れたかどうか。
  // 「項目が1件も無いなら入れる」だけで判断すると、利用者が全部消しても開き直すたびに
  // 戻ってきて消せなくなる。入れたことがあるかどうかを別に持つ。
  activityPresetsSeeded Boolean @default(false)

  // 活動記録の保存先カレンダー。全ての項目で共通の1つ（docs/spec.md §27）。
  // 未設定なら予定作成の既定の保存先（CalendarSetting.isCreateDefault）へ入れる。
  // カレンダー名・色はGoogle側が一次情報源のため持たない。
  activityCalendarId String?

  // 祝日として扱うGoogleカレンダー（issue #699）。「日本の祝日」等の公開カレンダーは
  // 読み取り専用（accessRole: reader）で購読されるのが通常のため、書き込み可能な
  // カレンダーだけを集める WritableCalendar の枠組みには乗らない。固定のカレンダーIDを
  // ハードコードせず、設定で利用者に選ばせる（ユーザーが別IDで祝日カレンダーを
  // 追加している場合にも対応するため）。未設定なら祝日の優先表示は行わない。
  holidayCalendarId String?

  // 睡眠として数える活動記録の項目名（docs/spec.md §39）。既定は初期項目と同じ「睡眠」。
  // ActivityPreset 側に印を持たせないのは、項目を消したり作り直したりすると、
  // その名前で残っている過去の記録が数えられなくなるため。Google側の予定には
  // 「これは睡眠」と書ける欄が無く、判定できるのは項目名だけになる。
  sleepActivityTitle String @default("睡眠")

  // 1晩の目標睡眠時間（分・既定は7時間＝420分・docs/spec.md §39）。
  // 年度の開始月・所定労働時間と同じく、期間ごとではなく全期間共通の1つにする。
  // 期間ごとに変えられると、同じ夜の「足りている / 足りていない」が開くたびに違う答えになる。
  sleepTargetMinutes Int @default(420)

  // 年度の開始月（1〜12・docs/spec.md §34）。年休の取得状況を年度で区切るために使う。
  // 全年度に効く1つの値として持つ。年度ごとに区切りが変わると、同じ年度の数字が
  // 開くたびに違う期間の集計になるため。
  fiscalYearStartMonth Int @default(4)

  // 1日の所定労働時間（分・既定は7時間45分＝465分・docs/spec.md §34）。
  // 時間休（`3時間休`）が1日ぶんの何割かを決める。使うのは入力ダイアログの時間数の上限と、
  // 年休画面の帯・消化ペースの比率だけで、年休を数える処理では使わない（全休・半休は日、
  // 時間休は時間のまま数え、1つの数へ丸めないため）。開始月と同じく全年度共通の1つにする。
  workMinutesPerDay Int @default(465)

  // 移動の既定値（docs/spec.md §29）。活動記録の保存先と同じく、項目ごとではなく
  // 利用者につき1組にする。移動のたびに同じ出発地・交通手段を選び直さずに済ませるため。
  travelDefaultOrigin String?
  travelDefaultMode   TravelMode @default(PUBLIC_TRANSIT)
  // 行きだけ作られても帰りは手で入れ直すことになるため、往復を既定にする。
  travelRoundTrip     Boolean    @default(true)
  // 移動をGoogle Calendarへ書き出す先。未設定なら予定作成の既定の保存先へ入れる。
  travelCalendarId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 年休の付与（docs/spec.md §34）。
//
// 年休の記録そのものはNotionの勤務記録DBが一次情報源だが、「その年度に何日使えるのか」は
// 日ごとの記録ではなく勤怠制度の設定値で、Notionのページとしては形が合わない。DaySpan固有の
// 設定としてここに置く。
model AnnualLeaveGrant {
  id     String @id @default(cuid())
  userId String

  // 年度の開始年。開始月（UiSetting.fiscalYearStartMonth）が4月なら
  // 2026 = 2026-04-01〜2027-03-31。開始月を変えると、同じ行が指す期間も一緒に動く。
  fiscalYear Int

  // その年度に付与された日数と、前年度からの繰越。半休を0.5日で数える（annualLeaveDays()）
  // ため、日数は小数で持つ。
  grantedDays     Float
  carriedOverDays Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 同じ年度の付与が2件あると、どちらで計算するのかが決まらない。
  @@unique([userId, fiscalYear])
}

// --- 活動記録 ---
// いましていることを押して記録し、終わった時点でGoogle Calendarの予定にする（docs/spec.md §27）。
// 予定の本体はGoogle側に作られる。ここに置くのは選択肢と「まだ終わっていない1件」だけで、
// 終わった記録をDaySpanへ残すことはしない（docs/spec.md §19）。

model ActivityPreset {
  id     String @id @default(cuid())
  userId String

  name      String
  sortOrder Int    @default(0)

  // カレンダー等に出すアイコンのキー（src/lib/activity-icons.ts）。未設定は名前から既定を引く。
  icon String?

  // 保存先カレンダーはここには持たない。項目によらず1つ（UiSetting.activityCalendarId）。

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 同じ名前の選択肢が2つ並ぶと、押したときにどちらが選ばれたのか区別できない。
  // 初期の選択肢を後から足すときも、この一意制約で二重登録を防いでいる。
  @@unique([userId, name])
}

// 進行中の記録。同時に2つのことを記録しても、どちらが「いましていること」か決まらないため
// ユーザーにつき1件（userId が一意）。停止・切り替えの時点でGoogleへ書き出して削除する。
model RunningActivity {
  id     String @id @default(cuid())
  userId String @unique

  title      String
  calendarId String
  startedAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- 移動 ---
// 出発地から目的地までの移動（docs/spec.md §29）。
//
// Google Calendarの予定はタイトル・場所・説明しか持てず、出発地と目的地を別々の欄には
// 入れられない。移動に固有の項目を持たせるため、本体はここに置く。
// Google側へは写しを書き出し、他の端末のカレンダーからも見えるようにする（一次情報源はこちら）。

/// 交通手段。電車・バス・飛行機はいずれもYahoo!乗換案内で経路検索できるため、公共交通として
/// 1つにまとめる（issue #538）。自転車はどの分類にも当てはまらないため、その他へ含める。
enum TravelMode {
  CAR
  PUBLIC_TRANSIT
  WALK
  OTHER
}

/// 所要時間の出どころ。AIの見積もりは目安でしかないため、手で入れた値と区別して示す。
/// 将来Routes APIなどへ差し替えるときも、既存の記録がどちらで入ったか分かるようにする。
/// 所要時間の出どころ（docs/spec.md §29）。
///
/// TRANSIT は旧trainroute経由で引いた経路検索の結果（撤去済み。issue #591）。既存の移動に
/// 残る過去データとして値は残しており、書き換えていない。新しくこの値が付く移動は今後作られない。
enum TravelEstimateSource {
  MANUAL
  AI
  TRANSIT
  YAHOO
  GOOGLE_MAPS
}

model TravelPlan {
  id     String @id @default(cuid())
  userId String

  origin      String
  destination String
  mode        TravelMode @default(PUBLIC_TRANSIT)

  departAt DateTime
  arriveAt DateTime

  note           String?              @db.Text
  estimateSource TravelEstimateSource @default(MANUAL)

  // 元になった予定。往路・復路の2件が同じ予定を指す。予定側から移動の有無を引くために持つ。
  linkedEventId    String?
  linkedCalendarId String?
  returnLeg        Boolean @default(false)

  // Googleへ書き出した予定。書き出しに失敗した場合はnullのまま残す（移動そのものは失われない）。
  googleCalendarId String?
  googleEventId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, departAt])
  // 書き出した予定はGoogleからも取得される。二重に描かないよう、取得した予定のIDで引いて落とす。
  @@index([userId, googleEventId])
}

// --- iPhoneウィジェット連携 ---
// Scriptableから活動記録を読むための専用トークン（docs/spec.md §28）。
// Scriptableはブラウザのログインセッションを持てず、ウィジェットの更新は利用者の操作なしに
// 走るため、Supabaseのセッションでは認証できない。読み取り専用のトークンを1本だけ発行する。
model WidgetToken {
  id     String @id @default(cuid())
  userId String @unique // ウィジェット用は1ユーザー1本。複数の端末でも同じ台本を使い回す

  // 暗号文はIVが毎回変わるため値では引けない。照合はハッシュ側で行い、
  // 暗号文は設定画面での再表示（台本の作り直し・機種変更）にだけ使う。
  tokenHash String @unique @db.VarChar(64) // SHA-256（hex）
  token     String @db.Text // secret-cipher.ts でAES-256-GCM暗号化

  // 最後に使われた日時。ウィジェットが生きているか、古い端末が読み続けていないかを見るため。
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- ヘルスケア連携（iOSアプリ・docs/spec.md §40） ---
// ヘルスケアへ送った位置の印と控え（docs/spec.md §40「ヘルスケアへ送る」）。ユーザーに1行。
//
// 送った履歴（SleepHealthSent）と同じくユーザー単位で持つ。
model SleepHealthExport {
  id     String @id @default(cuid())
  userId String @unique

  // これより後に終わった睡眠だけを次に返す。書き終えたあとの POST でだけ進める
  // （取得した時点で進めると、途中で止まった夜が二度と返らない）。
  exportedUntil DateTime?

  // 直近のGETが返した内容の控え（docs/spec.md §40「送ったあとの変更」）。POSTが `until` の一致を
  // 確かめてから SleepHealthSent へ反映する。
  pending Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ヘルスケアへ**送った時点の**睡眠の時間帯（docs/spec.md §40「送ったあとの変更」）。
//
// ショートカットにはヘルスケアの既存サンプルを更新・削除するアクションが無く、追加しかできない。
// 送ったあとに時刻を直した・消した睡眠を見つけて「変更後を追加で送る」「古い時間帯はヘルスケアで
// 消してもらう」には、何をいつの時刻で送ったかを持つ必要がある。Googleの予定のIDで引く
// （時刻を直してもIDは変わらない）。ヘルスケア側の実体は読めないため、これは送った履歴であって
// ヘルスケアの中身そのものではない。
model SleepHealthSent {
  id      String @id @default(cuid())
  userId  String
  eventId String @db.VarChar(255) // Googleの予定ID

  start  DateTime // 送った開始
  end    DateTime // 送った終了
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, end])
}

// --- 予定に紐づくタスク ---
// タスクを「この予定のどの段階でやるか」で置く（docs/spec.md §31）。
//
// Google Calendarの予定にもNotionのタスクにも「相手を指す欄」は無く、足せば利用者のDBの
// 構成を変えることになる。予定とタスクを結ぶ線だけをDaySpanが持つ（移動と同じ考え方）。
// 段階から決まる日時はNotionのタスクの「期限」か「予定日」へ書き込むため、カレンダーの
// 描画・取得は既存の日付の経路をそのまま通る。

/// タスクを予定のどの段階に置くか。実施中は開始時刻、終了までは終了時刻に置く。
enum TaskEventStage {
  BEFORE_START
  DURING
  BEFORE_END
  AFTER_END
}

/// 段階から決まる日時をタスクのどちらの日付へ入れるか（docs/spec.md §31）。
/// 締切そのものが予定で決まる（会議で提出する）場合と、いつ手を付けるかが予定で決まる
/// 場合があり、行き先を選べないとどちらかを手で書き写すことになる。
enum TaskLinkTarget {
  DUE
  PLANNED
}

model TaskEventLink {
  id     String @id @default(cuid())
  userId String

  taskId     String // Notionのページ ID
  calendarId String
  eventId    String // 繰り返し予定は展開した1回分のID。移動への紐づけ（travelId あり）では空文字

  // 紐づけ先が移動（TravelPlan）のときの移動ID。nullなら予定への紐づけ（issue #914）。
  // 移動は予定から作る派生データで、出発前に確かめるタスクを置く先として使う。
  // calendarId / eventId を nullable にすると既存の型・クエリの全てに波及するため、
  // 移動のときは空文字を入れ、travelId の有無で見分ける。
  travelId String?

  stage TaskEventStage

  // 決まった日時の行き先。既定を予定日にするのは、行き先を足す前の紐づけがすべて予定日へ
  // 書いていたため。既定値のままで既存の行の意味が変わらない。
  target TaskLinkTarget @default(PLANNED)

  // 最後に行き先へ入れた日時。予定が動いてタスクの日付とずれていないかの判定に使う。
  resolvedAt     DateTime
  // 解決した日時が終日（日付のみ）だったか。日付のみと00:00の時刻ありを区別するために持つ。
  resolvedAllDay Boolean  @default(false)

  // 表示用の予定名の写し。一次情報源はGoogleで、取得できたときは最新の値で上書きする。
  // タスク画面や取得範囲の外では予定本体が手元に無く、何に紐づいているか示せないため持つ。
  eventTitle String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 紐づけは行き先ごとに1件。期限と予定日で別の予定へ紐づけられる一方、同じ行き先の2件目は
  // 入る先が1つしか無いため持てても置けない。
  @@unique([userId, taskId, target])
  // 予定を動かした・消したときに、その予定に紐づくタスクを引くため。
  @@index([userId, eventId])
  // 移動を動かした・消したときに、その移動に紐づくタスクを引くため。
  @@index([userId, travelId])
}

// --- 通知 ---
// 予定の前とタスクの期限に知らせる（docs/spec.md §32）。
//
// iOSのホーム画面Webアプリには、端末側で「この時刻に鳴らす」と予約する手段が無い。
// 時刻が来たことに気付けるのはサーバーだけなので、通知はすべてDaySpanから送る。
// 送る瞬間に外部APIを叩かずに済むよう、通知の文面は先に作って NotificationJob へ置く。

/// 通知の出どころ。押したときに開く画面もここで決まる。
enum NotificationKind {
  EVENT
  TASK
  TASK_DIGEST
  ACTIVITY
  TEST
}

/// 通知の送信先（端末ごと）。
///
/// 許可はブラウザが持つもので、iPhoneとPCでは別々になる。「何分前に知らせるか」のような
/// 内容の設定はアカウントにつき1つ（NotificationSetting）で、こちらは端末の数だけ増える。
model PushSubscription {
  id     String @id @default(cuid())
  userId String

  // ブラウザが発行する送信先。長さに上限が決まっておらずMySQLのインデックス長に収まらないため、
  // 引くのはハッシュ側で行う（ウィジェットのトークンと同じ作り）。
  endpoint     String @db.Text
  endpointHash String @unique @db.VarChar(64) // SHA-256（hex）

  // ペイロードの暗号化に使う端末側の公開鍵と認証シークレット（RFC 8291）。
  // どちらもブラウザがその端末のために発行した値で、DaySpanの資格情報ではない。
  p256dh String @db.VarChar(255)
  auth   String @db.VarChar(255)

  /// 購読したときに開いていたアドレス（`https://dayspan.gucchii.com` など）。
  /// 通知を押したときの行き先は絶対URLで渡す必要があり、送信はリクエストの外（タイマー）から
  /// 走るためヘッダーからは作れない。環境変数を1つ増やすより、購読した端末が使っている
  /// アドレスをそのまま持つほうが、本番とローカルの両方で正しい行き先になる。
  origin String @db.VarChar(255)

  /// 設定画面で端末を見分けるための表示名。User-Agentから作る。
  label String?

  lastSuccessAt DateTime?
  lastFailureAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// iOSアプリ（WKWebView）の通知の送信先（APNsのデバイストークン）。
///
/// WKWebViewの中ではWeb Push（Service Worker の push）が動かないため、アプリはAPNsで受ける。
/// PWA向けのWeb Push（PushSubscription）はそのまま残り、同じ文面を両方へ送る（docs/spec.md §32）。
model ApnsDevice {
  id     String @id @default(cuid())
  userId String

  /// APNsのデバイストークン（16進。長さはAppleが決めるため余裕を持たせる）。
  token String @unique @db.VarChar(200)

  /// トークンを発行したAPNsの環境。Xcodeから入れたビルドは sandbox、TestFlight・App Storeは
  /// production で、トークンは環境をまたいで使えない。送り先のホストを分けるために持つ。
  environment String @db.VarChar(16)

  /// 端末を見分けるための表示名（iPhone / iPad）。同じ端末のPWAとの二重通知を避けるために
  /// Web Pushの購読の表示名と突き合わせる。
  label String?

  lastSuccessAt DateTime?
  lastFailureAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// iOSアプリのライブアクティビティを「始める」ためのトークン（push-to-start・iOS 17.2以降・issue #971）。
/// アプリが動いていない間にWeb・他の端末・ショートカットで記録が始まったとき、サーバーが
/// これ宛にAPNsを送ってロック画面にアクティビティを出す。ApnsDevice（通常の通知）とは別の値。
model LiveActivityDevice {
  id     String @id @default(cuid())
  userId String

  token       String @unique @db.VarChar(200)
  /// トークンを発行したAPNsの環境（sandbox / production）。環境をまたいでは使えない。
  environment String @db.VarChar(16)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 表示中のライブアクティビティを更新・終了するためのトークン（activity push token・issue #971）。
/// アクティビティごとにOSが発行する。1端末に1つずつ持つため、ユーザーに複数ありうる。
model LiveActivityToken {
  id     String @id @default(cuid())
  userId String

  token       String @unique @db.VarChar(200)
  environment String @db.VarChar(16)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// ライブアクティビティの停止ボタン用トークン（issue #971）。アプリのKeychain（App Group）に置かれ、
/// ロック画面の停止ボタン（AppIntent）が使う。WidgetToken（読み取り専用）とは
/// 分け、できるのは「記録の停止」と「自分のアクティビティのトークン登録」だけ。
model ActivityStopToken {
  id     String @id @default(cuid())
  userId String @unique

  tokenHash String @unique @db.VarChar(64) // SHA-256（hex）
  token     String @db.Text // secret-cipher.ts でAES-256-GCM暗号化

  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 何を知らせるか（アカウントにつき1つ）。
model NotificationSetting {
  id     String @id @default(cuid())
  userId String @unique

  // 予定は開始の何分前に知らせるか。0なら開始時刻ちょうど。
  eventEnabled     Boolean @default(true)
  eventLeadMinutes Int     @default(10)

  // タスクは期限の時刻に知らせる。時刻の無い期限はその日ぶんをまとめて1通にし、
  // 送る時刻をここで決める（UiSetting.timeZone での HH:MM）。1件ずつ送ると、
  // 同じ時刻に同じ見た目の通知が期限の数だけ並ぶため。
  taskEnabled    Boolean @default(true)
  taskDigestTime String  @default("08:00") @db.VarChar(5)

  /// 記録を始めたときに「記録中」を通知として残すか（docs/spec.md §27）。
  // 記録の開始通知は廃止（issue #999）。列はマイグレーションを避けて残し、読み書きしない。
  activityEnabled Boolean @default(true)

  /// 下書きを作り直した最後の時刻。取得の間隔を空けるために持つ。
  plannedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 送る前の通知1件。
///
/// 予定・タスクの取得は30分に1回にまとめ、その時点で文面まで作っておく。送る直前に
/// 取りにいく作りだと、通知1件ごとにGoogle・Notionへの往復が増える（docs/spec.md §20）。
model NotificationJob {
  id     String @id @default(cuid())
  userId String

  kind NotificationKind

  /// 同じ通知を二重に作らないための鍵。予定が動けば別の値になるよう、日時まで含める。
  dedupeKey String @db.VarChar(191)

  scheduledAt DateTime
  title       String   @db.VarChar(255)
  body        String   @db.Text

  /// 押したときに開くパス。
  url String @db.VarChar(255)

  /// 一緒に更新するアイコンのバッジの件数。送信時に数え直すとNotionへの往復が増えるため、
  /// 下書きを作った時点の件数を持つ。
  badgeCount Int?

  /// 送った時刻。null なら未送信。
  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  // 時刻が来た未送信の下書きを引く。
  @@index([sentAt, scheduledAt])
  @@index([userId, scheduledAt])
}

// --- 予定の中止・不参加 ---
// 行かなかった予定を消すと、その日に何があったのかまで消える（docs/spec.md §37）。
// 予定はカレンダーに残したまま「起こらなかった」の一段だけを足す。
//
// Google Calendarには「中止だが残す」欄が無い。status: cancelled は削除相当で予定そのものが
// 消え（listEvents() も落としている）、出欠（responseStatus）は招待された予定にしか無い。
// タイトル・説明へ「【中止】」と書き足すと、記録を外したあとも文字列が残り、外部で編集された
// ときに壊れる。移動（TravelPlan）・タスクの紐づけ（TaskEventLink）と同じく、相手のDBに欄が
// 無いものは線だけをDaySpanが持つ。

/// 予定に付ける「起こらなかった」の種類。
///
/// 「開かれなかった」と「行われたが自分は行かなかった」は別の事実で、あとから見返すときに
/// 読みたいのはその違い。1つにまとめると、予定を消さずに残す理由が半分になる。
enum EventOutcomeKind {
  /// 中止。予定そのものが無くなった（相手都合・雨天中止・休講）。
  CANCELED
  /// 不参加。予定は行われたが自分は行かなかった（体調・都合）。
  ABSENT
}

model EventOutcome {
  id     String @id @default(cuid())
  userId String

  calendarId String
  eventId    String // 繰り返し予定は展開した1回分のID

  kind EventOutcomeKind
  // 理由（体調・都合）は場面ごとに違うため選択肢にせず自由入力にする。空のままでもよい。
  note String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 予定1件につき1つ。中止と不参加が同時に立つことはない。
  @@unique([userId, eventId])
}

// --- 予定ごとの通知設定（issue #708） ---
// アカウント単位の設定（NotificationSetting.eventLeadMinutes）は全予定に一律で適用される。
// この予定だけ通知したくない・複数回通知したい、という要望には応えられない。Googleの予定には
// reminders欄があるが、それはGoogleカレンダー自身の通知（popup/email）向けの欄で、DaySpanが
// 送るWeb Push通知の下書き（NotificationJob）の計算には使えない。EventOutcome・TaskEventLink・
// TravelPlanと同じく、相手のDBに欄が無いものは線だけをDaySpanが持つ。

model EventNotificationSetting {
  id     String @id @default(cuid())
  userId String

  calendarId String
  eventId    String // 繰り返し予定は展開した1回分のID（EventOutcomeと同じ）

  /// この予定を通知するか。false ならアカウント設定によらず作らない。
  enabled Boolean @default(true)

  /// 開始の何分前に知らせるか（分の配列）。複数件で複数回通知する。オフにしても選んでいた
  /// 値は残す（次にオンへ戻したときに選び直させないため。通知設定画面の既存の扱いと同じ）。
  leadMinutes Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 予定1件につき1つ。
  @@unique([userId, eventId])
}

// --- AIの使用量（issue #680）---
// ops-dashboardの「アプリ別のAI利用」が `GET /api/internal/ai-usage` 経由で機能×モデルごとに読む。

/// Anthropic APIを1回呼ぶごとの使用量。成功した応答1件につき1行。
///
/// 記録するのは回数とトークン数だけで、プロンプト本文・応答・入力した文字列は持たない。
/// 利用者に紐づく情報ではなくアプリ全体の使用量なので `userId` も持たない。
/// 表示・集計専用の記録なので、書き込みに失敗してもAIの呼び出しそのものは成立させる。
model AiUsageLog {
  id      Int    @id @default(autoincrement())
  /// 機能の識別子（`src/lib/ai-usage.ts` の `AiFeature`）。画面に出す名前は集計時に引くため、
  /// ここへ持たない（名前を直しても過去の行が別の機能に割れない）。
  feature String @db.VarChar(64)
  /// 応答が返したモデルID。日付付きのIDのことがある。応答に無ければ要求したID。
  model   String @db.VarChar(128)

  /// キャッシュに載らなかった入力トークン（`usage.input_tokens`）。
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int @default(0)
  cacheWriteTokens Int @default(0)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// --- iOSアプリ（issue #908）---
// ASWebAuthenticationSession と WKWebView はCookieを共有しないため、外部認証で確立した
// セッションをWebViewへ引き継ぐための一度限りの記録。docs/spec.md「iOSアプリ」・CLAUDE.md参照。

/// ログインの引き継ぎ。認証シート側の /auth/callback が作り、WKWebView側の /auth/native/consume が
/// 一度だけ消費する。コードはハッシュで持ち、セッションのトークンは暗号化して短時間だけ置く。
model NativeAuthHandoff {
  id            String    @id @default(cuid())
  /// 引き継ぎコード（アプリへ返す値）のSHA-256。値そのものは保存しない
  codeHash      String    @unique @db.VarChar(64)
  /// 用途。別フローのコードを拒否するため（現状は "login" のみ）
  purpose       String    @db.VarChar(32)
  /// アプリが持つ code_verifier のS256。消費時に verifier と突き合わせる
  challengeHash String    @db.VarChar(64)
  /// access/refresh token を secret-cipher.ts で暗号化したJSON
  sessionCipher String    @db.Text
  /// ログイン後の遷移先（resolveInternalPath で確かめてから使う）
  next          String?   @db.VarChar(512)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}

/// Google Calendar連携の開始intent。ログイン済みのWKWebViewが発行し、Cookieを持たない認証シートで
/// 一度だけ使う。GET のクエリにトークンが載るため、connect の時点で使い捨てにする。
model GoogleConnectIntent {
  id             String    @id @default(cuid())
  userId         String
  /// intentトークンのSHA-256
  tokenHash      String    @unique @db.VarChar(64)
  /// connect（開始）の時点で立てる。以後このintentでは開始できない
  usedAt         DateTime?
  /// 発行から60秒。ログに残った値を後から使っても通らない
  expiresAt      DateTime
  /// OAuthのstateのSHA-256。callbackがこれでintentを引く
  stateHash      String?   @unique @db.VarChar(64)
  /// connect後、同意画面で操作する時間。callbackはこの期限内だけ受ける
  stateExpiresAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

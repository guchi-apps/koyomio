# アプリ実行時に参照する環境変数（値は空。ローカル開発の記入例は .env.local.example を参照）

# MariaDB接続。DB_* から scripts/construct-database-url.sh が組み立てる（本番）
DATABASE_URL=

# Supabase Auth（他アプリと共有のSupabaseプロジェクト）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 利用を許可するGoogleアカウント（カンマ区切り）。未設定の場合は全員ログイン不可

# Google/NotionのトークンをDBへ保存する際の暗号化鍵（base64エンコードした32byte）
TOKEN_ENCRYPTION_KEY=

# Google Calendar連携用のDaySpan専用OAuthクライアント（ログイン用とは別クライアント）
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# 予定の「場所」欄のAI提案（Claude Messages API）。未設定の場合はAI提案のみ使えない
CLAUDE_CODE_OAUTH_TOKEN=

# 買い物リストのカテゴリの自動判定（TypeSafeのJev）。未設定の場合は判定だけが使えない
TYPESAFE_API_KEY=

# デプロイ時のみ使用（DATABASE_URL の組み立て元。scripts/construct-database-url.sh）
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# 通知（Web Push）のVAPID鍵（docs/notifications.md）。node scripts/gen-vapid-keys.mjs で作る。
# 未設定の場合は通知だけが使えない（他の機能には影響しない）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# iOSアプリ（APNs）の認証キー（docs/notifications.md「iOSアプリ（APNs）」）。.p8 をbase64にした1行。
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# サーバー間参照用API（/api/internal/*）の共有シークレット（docs/internal-api.md）。
# 未設定の場合はこのAPIだけが503を返す（他の機能には影響しない）
INTERNAL_API_KEY=

# POST /api/internal/events（予定の作成）専用の共有シークレット。読み取り用の INTERNAL_API_KEY
# とは別の値にする（読み取り用のキーが漏れても予定を書き込まれないようにするため）。
# 未設定の場合はこのAPIだけが503を返す（他の機能には影響しない）
INTERNAL_EVENTS_API_KEY=

# POST/PATCH /api/internal/tasks 専用の共有シークレット。読み取り用・予定書き込み用とは別にする。
# 未設定の場合はタスク書き込みAPIだけが503を返す。
INTERNAL_TASKS_API_KEY=

# ops-dashboardがAIの使用量（GET /api/internal/ai-usage）を読むときのBearer認証（docs/internal-api.md）。
# ops-dashboardの OPS_API_TOKEN と同じ値（1Password: apps/ops-dashboard/ops-api-token）。
# 未設定の場合はこのAPIだけが常に401を返す（他の機能には影響しない）
OPS_API_TOKEN=

# issue-deckの共有トークンAPI（issue #860）。DAYSPAN_INTERNAL_API_KEY・DAYSPAN_INTERNAL_EVENTS_API_KEY・DAYSPAN_INTERNAL_TASKS_API_KEY・
# OPS_API_TOKEN・TYPESAFE_API_KEYをここから読み、取得できないときだけ上の同名（INTERNAL_*は接頭辞なし）の
# 環境変数へ落ちる。SHARED_TOKEN_API_SECRETの正は op://apps/issue-deck/shared-token-api-secret。
# ISSUE_DECK_URLはorganization variableのAPP_BASE_URL。どちらかが空なら共有トークンは使わない
SHARED_TOKEN_API_SECRET=
ISSUE_DECK_URL=

# CI/デプロイ通知
SIGNALY_WEBHOOK_URL=

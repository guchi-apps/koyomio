# ローカル開発用。`pnpm env:init` で .env.local としてコピーしてから編集する。
# .env.local はgit管理外。実シークレットはここ、1Password、またはissue-deckの共有トークンだけに置く。

# ローカルのMariaDB/MySQL。pnpm db:setup がこのURLからDB・ユーザーを作成する
DATABASE_URL="mysql://dayspan:dayspan@127.0.0.1:3306/app_dayspan"

# Supabase Auth（他アプリと共有のSupabaseプロジェクト。1Password: apps/Supabase）
# Redirect URLs に http://localhost:3000/auth/callback の登録が必要
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# 自分のGoogleアカウントのメールアドレス

# `openssl rand -base64 32` で生成する
TOKEN_ENCRYPTION_KEY=""

# Google Calendar連携用のOAuthクライアント（開発用クライアント。1Passwordには登録せずここに直接記載する）
# 承認済みリダイレクトURI: http://localhost:3000/api/google/callback
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# 予定の「場所」欄でAIに候補を出させるためのトークン（1Password: apps/Anthropic）。
# `claude setup-token` で発行する長期トークン。未設定でもAIの提案以外は動く。
CLAUDE_CODE_OAUTH_TOKEN=""

# 買い物リストのカテゴリの自動判定（TypeSafeのJev。1Password: apps/issue-deck の typesafe-api-key）。
# 未設定でも判定以外は動く。
TYPESAFE_API_KEY=""

# 通知（Web Push）のVAPID鍵（docs/notifications.md）。
# `node scripts/gen-vapid-keys.mjs mailto:自分のメールアドレス` の出力をそのまま貼る。
# 未設定でも通知以外は動く。ローカルで通知を試すにはHTTPSとService Workerが要るため、
# 実機での確認は本番（またはビルドしたサーバー）で行う。
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
# iOSアプリ（APNs）の認証キー（docs/notifications.md）。.p8 をbase64にした1行。
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY=""

# サーバー間参照用API（/api/internal/*）のローカル用フォールバック（docs/internal-api.md）。
# 本番の正はissue-deckのDAYSPAN_INTERNAL_API_KEY。共有トークンAPIを設定しないローカル確認用にだけ、
# 適当な値を置く（本番の値は使わない）。`openssl rand -hex 32` など
INTERNAL_API_KEY=""

# POST /api/internal/events（予定の作成）専用。正はDAYSPAN_INTERNAL_EVENTS_API_KEYで、読み取り用と別の値。
# 共有トークンAPIを設定しないローカル確認用のフォールバックにだけ使う。
INTERNAL_EVENTS_API_KEY=""

# POST/PATCH /api/internal/tasks専用。正はDAYSPAN_INTERNAL_TASKS_API_KEYで、読み取り用・予定書き込み用とは別の値。
# 共有トークンAPIを設定しないローカル確認用のフォールバックにだけ使う。
INTERNAL_TASKS_API_KEY=""

# ops-dashboardがAIの使用量（GET /api/internal/ai-usage）を読むときのBearer認証（docs/internal-api.md）。
# ローカル確認用の適当な値でよい（本番の値は使わない）
OPS_API_TOKEN=""

# 開発サーバーのポート（省略時は3000）
# PORT=3000
